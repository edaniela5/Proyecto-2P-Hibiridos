    <P Name="FontName">Arial</P>
    <P Name="FontSize">12</P>
    <P Name="SystemSampleTime">.01</P>
    <Mask SelfModifiable="on">
      <Type>Longitudinal Driver</Type>
      <Display RunInitForIconRedraw="on" IconRotate="port" IconUnits="pixels">try
    IconInfo = autosharedicon(&apos;autoliboperlong&apos;, gcb, 4);
    
    image(IconInfo.image, IconInfo.position);
    
    for i = 1:numel(IconInfo.lconn)
        port_label(&apos;lconn&apos;, i, IconInfo.lconn{i})
    end
    
    for j = 1:numel(IconInfo.rconn)
        port_label(&apos;rconn&apos;, j, IconInfo.rconn{j})
    end
    
    for k = 1:numel(IconInfo.input)
        port_label(&apos;input&apos;, k, IconInfo.input{k})
    end
    
    for m = 1:numel(IconInfo.output)
        port_label(&apos;output&apos;, m, IconInfo.output{m})
    end
catch
    fprintf(&apos;Longitudinal \n Driver&apos;)
end</Display>
      <Description>autoblks_shared:autoblkLongitudinalDriver:blkDesc</Description>
      <Initialization>[~]=autosharedicon(&apos;autoliboperlong&apos;,gcb,0);</Initialization>
