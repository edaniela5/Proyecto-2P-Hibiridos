    <P Name="Variant">on</P>
    <P Name="VariantControl">Choice</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Type>Terrain Source</Type>
      <Display RunInitForIconRedraw="off"/>
      <Description>This variant subsystem provides the option for:
- a single point of contact for each wheel with minimal post-processing ideal for smooth surfaces and maximum run-time performance.
- multiple points of contact per wheel which may be used when interested in non-smooth terrain at a higher computational cost and requires Vehicle Dynamics Blockset.</Description>
      <MaskParameter Name="terrType" Type="popup">
        <Prompt>Terrain feedback type:</Prompt>
        <Value>Single point</Value>
        <TypeOptions>
          <Option>Single point</Option>
          <Option>Multiple points</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Parameters</Prompt>
        <DialogControl Type="Popup" Name="terrType">
          <Prompt>Terrain feedback type:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="PropagatedSignals">z</P>
      </Port>
      <Port Type="out" Index="2">
        <P Name="PropagatedSignals">DCM</P>
      </Port>
    </PortProperties>
    <System Ref="system_27576"/>
  </Block>
