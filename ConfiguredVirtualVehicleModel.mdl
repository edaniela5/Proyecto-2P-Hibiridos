  <Block BlockType="SubSystem" Name="ISO 15037-1:2006" SID="27432">
    <PortCounts in="1"/>
    <P Name="Position">[930, 199, 1105, 281]</P>
    <P Name="ZOrder">100000</P>
    <P Name="AttributesFormatString">%&lt;Measurement&gt;</P>
    <P Name="StopFcn">switch get_param(gcb,&apos;Measurement&apos;)
       case &apos;Enabled&apos;
       VDBSmldatxfolder=[matlabroot &apos;\toolbox\vdynblks\vdynsolution\mldatx&apos;];
       Simulink.sdi.loadView([VDBSmldatxfolder filesep &apos;ISO15037_1_2006E.mldatx&apos;]);
       Simulink.sdi.view;
end</P>
    <P Name="Variant">on</P>
    <P Name="VariantControlMode">label</P>
    <P Name="LabelModeActiveChoice">0</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Type>ISO 15037-1:2006</Type>
      <Display IconOpaque="opaque-with-ports" RunInitForIconRedraw="off">disp(&apos;ISO 15037-1:2006&apos;)</Display>
      <Description>Enables display of ISO 15037-1:2006 standard measurement signals in the Simulation Data Inspector.</Description>
      <Initialization>
v=ver;
isVDBSInstalled=dig.isProductInstalled(&apos;Vehicle Dynamics Blockset&apos;);
maskObj=Simulink.Mask.get(gcb);
parameterObj=maskObj.getParameter(&apos;Measurement&apos;);

    if isVDBSInstalled
    
        parameterObj.Enabled=&apos;on&apos;;
    
        switch get_param(gcb,&apos;Measurement&apos;)
            case &apos;Disabled&apos;
                set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;0&apos;)
            case &apos;Enabled&apos;
               set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;1&apos;)
            otherwise
               set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;0&apos;)
        end
        
    else
       
       parameterObj.Enabled=&apos;on&apos;; 
       set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;0&apos;);
       parameterObj.Enabled=&apos;off&apos;;
       
    end
</Initialization>
      <Help>eval(&apos;vdynblkshelp(&apos;&apos;iso15037&apos;&apos;)&apos;);</Help>
      <MaskParameter Name="Measurement" Type="radiobutton">
        <Prompt>ISO Measurements</Prompt>
        <Value>Disabled</Value>
        <Callback>switch get_param(gcb,&apos;Measurement&apos;)
    case &apos;Disabled&apos;
        set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;0&apos;)
    case &apos;Enabled&apos;
       set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;1&apos;)
    otherwise
       set_param(gcb,&apos;OverrideUsingVariant&apos;,&apos;0&apos;)
end</Callback>
        <TypeOptions>
          <Option>Enabled</Option>
          <Option>Disabled</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="RadioButton" Name="Measurement">
          <Prompt>ISO Measurements</Prompt>
        </DialogControl>
      </DialogControl>
    </Mask>
    <System Ref="system_27432"/>
  </Block>
