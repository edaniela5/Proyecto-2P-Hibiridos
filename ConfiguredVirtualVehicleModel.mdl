planeSurface.createShape(&apos;checker&apos;,[200,200,+0.03],[50,50]);
planeSurface.Translation = [0 0 0]; 
planeSurface.Shininess = 0;
planeSurface.Transparency = 0;
planeSurface.TextureMapping.Blend = 1;
planeSurface.TextureMapping.Roughness = .8;
World.add(planeSurface,Actor);</P>
