  <Block BlockType="SubSystem" Name="Ideal Inclined Plane" SID="27715">
    <PortCounts in="4" out="2"/>
    <P Name="Position">[580, 30, 730, 525]</P>
    <P Name="ZOrder">100000</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Type>Ideal Plane Elevation Generator</Type>
      <Display RunInitForIconRedraw="off"/>
      <Description>This block accepts time varying bank and pitch angles for an idealized planar surface centered at the global origin (Z+up). 
The plane roll or bank angle, phi, is about the X axis and pitch (negative grade) angle is about the Y.
A static vertical offset is also permited.
Based on the initial plane angles and vertical offset and vehicle pose, estimates of the initial vehicle roll and pitch are calculated (in the vehicle Z+ down frame). These values can be optionally used to udpate the sldds.
Caution should be used to esnure the input signals and initial parameters are consistent at initialzation time.
If Simulink 3D Animation is available, the visualization will also include a planar surface (changing the default scene may be desired in the Visualization subsystem).</Description>
      <Initialization>vehdynicon(&apos;vehdynlibzplane&apos;,gcb,0,[]);</Initialization>
      <MaskParameter Name="phi_o" Type="edit" ShowTooltip="off">
        <Prompt>Initial plane bank angle (about global X axis) [rad]:</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="theta_o" Type="edit" ShowTooltip="off">
        <Prompt>Initial plane pitch angle (about global Y axis)  [rad]:</Prompt>
        <Value>EnvNominalGrade*pi/180</Value>
      </MaskParameter>
      <MaskParameter Name="Z_o" Type="edit" ShowTooltip="off">
        <Prompt>Initial plane elevation (at [0,0,0]) [m]</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="psi_o" Type="edit" ShowTooltip="off">
        <Prompt>Initial vehicle yaw angle (about global Z axis) [rad]:</Prompt>
        <Value>-PlntVehInitYawAng</Value>
      </MaskParameter>
      <MaskParameter Name="phi_est" Type="edit" Evaluate="off" Enabled="off" ShowTooltip="off">
        <Prompt>Estimated initial vehicle roll angle [rad]:</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="theta_est" Type="edit" Evaluate="off" Enabled="off" ShowTooltip="off">
        <Prompt>Estimated initial vehicle pitch angle [rad]:</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="Z_est" Type="edit" Enabled="off" ShowTooltip="off">
        <Prompt>Estimated initial vehicle elevation [m]</Prompt>
        <Value>0</Value>
      </MaskParameter>
      <MaskParameter Name="plane3D" Type="checkbox" Tunable="off" ShowTooltip="off">
        <Prompt>Enable 3D visualization of plane. Requires the Simulink 3D Animation and the 3D visualization enabled (in the Visualization subsystem). The Empty Scene is recommended when activated.</Prompt>
        <Value>off</Value>
        <Callback>vehdynicon(&apos;vehdynlibzplane&apos;,gcb,1,[]);</Callback>
      </MaskParameter>
      <MaskParameter Name="planeX" Type="edit" Enabled="off" ShowTooltip="off">
        <Prompt>Total plane length (in X dimension) [m]:</Prompt>
        <Value>200</Value>
      </MaskParameter>
      <MaskParameter Name="planeY" Type="edit" Enabled="off" ShowTooltip="off">
        <Prompt>Total plane width (in Y dimension) [m]:</Prompt>
        <Value>200</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="initParams">
        <Prompt>Setup Parameters</Prompt>
        <DialogControl Type="Edit" Name="phi_o">
          <Prompt>Initial plane bank angle (about global X axis) [rad]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="theta_o">
          <Prompt>Initial plane pitch angle (about global Y axis)  [rad]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="Z_o">
          <Prompt>Initial plane elevation (at [0,0,0]) [m]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="psi_o">
          <Prompt>Initial vehicle yaw angle (about global Z axis) [rad]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="slddUpdate">
        <Prompt>Vehicle Pose Estimates</Prompt>
        <DialogControl Type="Edit" Name="phi_est">
          <Prompt>Estimated initial vehicle roll angle [rad]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="theta_est">
          <Prompt>Estimated initial vehicle pitch angle [rad]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="Z_est">
          <Prompt>Estimated initial vehicle elevation [m]</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Button" Name="updateSLDD">
          <Prompt>Update data dictionary with initial roll, pitch and yaw estimates</Prompt>
          <Callback>vehdynicon(&apos;vehdynlibzplane&apos;,gcb,2,&apos;VirtualVehicleTemplate.sldd&apos;);</Callback>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="sim3d">
        <Prompt>Visualization Options</Prompt>
        <DialogControl Type="CheckBox" Name="plane3D">
          <Prompt>Enable 3D visualization of plane. Requires the Simulink 3D Animation and the 3D visualization enabled (in the Visualization subsystem). The Empty Scene is recommended when activated.</Prompt>
        </DialogControl>
        <DialogControl Type="Edit" Name="planeX">
          <Prompt>Total plane length (in X dimension) [m]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Edit" Name="planeY">
          <Prompt>Total plane width (in Y dimension) [m]:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <PortProperties>
