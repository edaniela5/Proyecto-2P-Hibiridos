<?xml version="1.0" encoding="utf-8"?>
<System>
  <P Name="Location">[-1, -7, 1280, 673]</P>
  <P Name="Open">on</P>
  <P Name="ZoomFactor">77</P>
  <P Name="ReportName">simulink-default.rpt</P>
  <P Name="SIDHighWatermark">27944</P>
  <Block BlockType="SubSystem" Name="Analyze Power and Energy" SID="27942">
    <PortCounts/>
    <P Name="Position">[745, 471, 885, 509]</P>
    <P Name="ZOrder">100000</P>
    <P Name="BackgroundColor">[0.796078, 0.796078, 0.796078]</P>
    <P Name="ShowName">off</P>
    <P Name="LibrarySourceProduct" Ref="bdmxdata:LibrarySourceProduct_27942"/>
    <P Name="OpenFcn">GenerateEnergyReportM2MLX</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Display>disp(getString(message(&apos;autoblks:autoblkVehMask:powAndEne&apos;)))</Display>
    </Mask>
    <System Ref="system_27942"/>
  </Block>
  <Block BlockType="SubSystem" Name="ChangeCurrentScenario" SID="26467">
    <PortCounts/>
    <P Name="Position">[978, 471, 1100, 509]</P>
    <P Name="ZOrder">100000</P>
    <P Name="BackgroundColor">[0.796078, 0.796078, 0.796078]</P>
    <P Name="ShowName">off</P>
    <P Name="HideAutomaticName">off</P>
    <P Name="OpenFcn">simstopped = autoblkschecksimstopped(gcb);
if simstopped
open_system(gcb,&apos;mask&apos;);
autoblkVVCSetupScenarioMask();
end</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Display RunInitForIconRedraw="off">disp(&apos;Change Current Scenario&apos;);</Display>
      <Initialization>autoblkVVCSetupScenarioMask();</Initialization>
      <MaskParameter Name="ScnType" Type="popup" ShowTooltip="off">
        <Prompt>Scenario type:</Prompt>
        <Value>Drive Cycle Tests</Value>
        <Callback>autoblkVVCSetScnType();</Callback>
        <TypeOptions>
          <Option>Drive Cycle Tests</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="ManType" Type="popup">
        <Prompt>Maneuver:</Prompt>
        <Value>Drive Cycle</Value>
        <Callback>autoblkVVCSetManType();</Callback>
        <TypeOptions>
          <Option>Drive Cycle</Option>
          <Option>Wide Open Throttle</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="CycleVar" Type="popup">
        <Prompt>Drive cycle source:</Prompt>
        <Value>FTP75</Value>
        <TypeOptions>
          <Option>FTP75</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="engine3d" Type="radiobutton" Enabled="off" ShowTooltip="off">
        <Prompt>Engine 3D:</Prompt>
        <Value>Disabled</Value>
        <TypeOptions>
          <Option>Disabled</Option>
          <Option>Enabled</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="driver" Type="popup">
        <Prompt>Driver:</Prompt>
        <Value>Longitudinal Driver</Value>
        <TypeOptions>
          <Option>Longitudinal Driver</Option>
        </TypeOptions>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>Change the current scenario in model. Updating the scenario does not change the test plans and test scripts in the Virtual Vehicle Composer app.</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Scenario Configuration</Prompt>
        <DialogControl Type="Popup" Name="ScnType">
          <Prompt>Scenario type:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="ManType">
          <Prompt>Maneuver:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Popup" Name="CycleVar">
          <Prompt>Drive cycle source:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="RadioButton" Name="engine3d">
          <Prompt>Engine 3D:</Prompt>
        </DialogControl>
        <DialogControl Type="Popup" Name="driver">
          <Prompt>Driver:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Button" Name="SetScenarioBtn">
          <Prompt>Apply scenario updates</Prompt>
          <Callback>autoblkVVCSetScenarioParameters();</Callback>
        </DialogControl>
        <DialogControl Type="Button" Name="OpenScnMask">
          <Prompt>Open scenario mask</Prompt>
          <Callback>autoblkVVCOpenScnMask();</Callback>
        </DialogControl>
      </DialogControl>
    </Mask>
    <System Ref="system_26467"/>
  </Block>
  <Block BlockType="SubSystem" Name="Controllers" SID="7337">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[900, 358, 975, 422]</P>
    <P Name="ZOrder">100000</P>
    <P Name="ContentPreviewEnabled">on</P>
    <P Name="PortSchema">{&quot;entries&quot;:[{&quot;content&quot;:{&quot;sides&quot;:[{&quot;content&quot;:{&quot;connectorIds&quot;:[]},&quot;type&quot;:&quot;ConnectorPlacement.EquallySpacedRectSide&quot;,&quot;uuid&quot;:&quot;a925dd9c-6905-4c67-a62c-b22bb69d2bd6&quot;},{&quot;content&quot;:{&quot;connectorIds&quot;:[&quot;Out1&quot;,&quot;In1&quot;],&quot;side&quot;:&quot;RIGHT&quot;},&quot;type&quot;:&quot;ConnectorPlacement.EquallySpacedRectSide&quot;,&quot;uuid&quot;:&quot;9930ed3e-43a4-46d4-b9ee-7ed64fae32ef&quot;},{&quot;content&quot;:{&quot;connectorIds&quot;:[],&quot;side&quot;:&quot;TOP&quot;},&quot;type&quot;:&quot;ConnectorPlacement.EquallySpacedRectSide&quot;,&quot;uuid&quot;:&quot;68d2ac4e-de3d-40d3-8b44-059f2a72a6bc&quot;}]},&quot;type&quot;:&quot;ConnectorPlacement.EquallySpacedConnector&quot;,&quot;uuid&quot;:&quot;c0be7d07-475b-4046-8bfa-76004f6da9b2&quot;}],&quot;packageUris&quot;:[&quot;http://schema.mathworks.com/mf0/Connector/R2020b&quot;],&quot;version&quot;:&quot;1.0&quot;}</P>
