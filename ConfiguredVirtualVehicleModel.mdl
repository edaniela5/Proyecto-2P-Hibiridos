  <Block BlockType="SubSystem" Name="Longitudinal Driver" SID="25509">
    <PortCounts in="11" out="4"/>
    <P Name="Position">[520, 67, 685, 533]</P>
    <P Name="ZOrder">100000</P>
    <P Name="HideAutomaticName">off</P>
