        <P Name="Name">mu</P>
      </Port>
    </PortProperties>
  </Block>
  <Block BlockType="BusSelector" Name="Bus&#xA;Selector" SID="27860">
    <PortCounts in="1" out="4"/>
    <P Name="Position">[85, 30, 90, 150]</P>
    <P Name="ZOrder">100000</P>
    <P Name="ShowName">off</P>
    <P Name="OutputSignals">FrntAxl.Lft.Disp.X,FrntAxl.Rght.Disp.X,RearAxl.Lft.Disp.X,RearAxl.Rght.Disp.X</P>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">&lt;X&gt;</P>
      </Port>
      <Port Type="out" Index="2">
        <P Name="Name">&lt;X&gt;</P>
      </Port>
      <Port Type="out" Index="3">
        <P Name="Name">&lt;X&gt;</P>
      </Port>
      <Port Type="out" Index="4">
        <P Name="Name">&lt;X&gt;</P>
      </Port>
    </PortProperties>
  </Block>
  <Block BlockType="BusSelector" Name="Bus&#xA;Selector1" SID="27861">
    <PortCounts in="1" out="4"/>
    <P Name="Position">[85, 150, 90, 270]</P>
    <P Name="ZOrder">100000</P>
    <P Name="ShowName">off</P>
    <P Name="OutputSignals">FrntAxl.Lft.Disp.Y,FrntAxl.Rght.Disp.Y,RearAxl.Lft.Disp.Y,RearAxl.Rght.Disp.Y</P>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">&lt;Y&gt;</P>
      </Port>
      <Port Type="out" Index="2">
        <P Name="Name">&lt;Y&gt;</P>
      </Port>
      <Port Type="out" Index="3">
        <P Name="Name">&lt;Y&gt;</P>
      </Port>
      <Port Type="out" Index="4">
        <P Name="Name">&lt;Y&gt;</P>
      </Port>
    </PortProperties>
  </Block>
  <Block BlockType="Demux" Name="Demux1" SID="27862">
    <PortCounts in="1" out="4"/>
    <P Name="Position">[570, 171, 575, 259]</P>
    <P Name="ZOrder">100000</P>
    <P Name="ShowName">off</P>
    <PortProperties>
      <Port Type="out" Index="1">
        <P Name="Name">mu_FL</P>
      </Port>
      <Port Type="out" Index="2">
        <P Name="Name">mu_FR</P>
      </Port>
      <Port Type="out" Index="3">
        <P Name="Name">mu_RL</P>
      </Port>
      <Port Type="out" Index="4">
        <P Name="Name">mu_RR</P>
      </Port>
    </PortProperties>
  </Block>
  <Block BlockType="SubSystem" Name="Road Track Friction" SID="27863">
    <PortCounts in="3" out="1"/>
    <P Name="Position">[390, 26, 540, 404]</P>
    <P Name="ZOrder">100000</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Type>Road Track Friction</Type>
      <Display IconOpaque="opaque-with-ports" RunInitForIconRedraw="off"/>
      <Initialization>% Scaling factor for the friction coefficient around the rectangular region
mutable = [lambda_g, lambda_g, lambda_g, lambda_g;
           lambda_g, lambda_r, lambda_r, lambda_g; 
           lambda_g, lambda_r, lambda_r, lambda_g; 
           lambda_g, lambda_g, lambda_g, lambda_g ];
       

% The step is distance between breakpoint near the boundary of high and
% low friction coefficient

step = 0.01 ; 

% In the mask initialization, xbr and ybr breakpoints are with respect to
% Body fixed coordinate system. At time t=0, xbr and ybr breakpoints
% updates to Earth (Inertial) Fixed coordinate system. The breakpoints for
% the lookup table are added via inputs.

xbr = [(r_x0 - step) , (r_x0 + step), (r_x0 + r_xw - step) , (r_x0 + r_xw + step) ];
ybr = [(r_y0 - step) , (r_y0 + step), (r_y0 + r_yw - step) , (r_y0 + r_yw + step) ];


% To check if the created track is split mu or constant mu

surface_popup = get_param(gcb, &apos;surface_popup&apos;);

if strcmp(surface_popup, &apos;Split friction coefficient scaling factor&apos;)
    SplitLambdaTrck = 1;
elseif strcmp(surface_popup, &apos;Constant friction coefficient scaling factor&apos;)
    SplitLambdaTrck = 0;
end</Initialization>
      <Help>eval(&apos;vdynblkshelp(&apos;&apos;vdynblkstrack&apos;&apos;)&apos;);</Help>
      <MaskParameter Name="surface_popup" Type="popup">
        <Prompt>Type of surface:</Prompt>
        <Value>Split friction coefficient scaling factor</Value>
        <Callback>surface_popup = get_param(gcb, &apos;surface_popup&apos;);
m = Simulink.Mask.get(gcb);

lambda_g = m.getParameter(&apos;lambda_g&apos;);
lambda_r = m.getParameter(&apos;lambda_r&apos;);
r_x0 = m.getParameter(&apos;r_x0&apos;);
r_y0 = m.getParameter(&apos;r_y0&apos;);
r_xw = m.getParameter(&apos;r_xw&apos;);
r_yw = m.getParameter(&apos;r_yw&apos;);
%track_view = m.getParameter(&apos;track_view&apos;);


if strcmp(surface_popup, &apos;Split friction coefficient scaling factor&apos;)
    lambda_g.Visible = &apos;on&apos;;
    lambda_r.Visible = &apos;on&apos;;
    r_x0.Visible = &apos;on&apos;;
    r_y0.Visible = &apos;on&apos;;
    r_xw.Visible = &apos;on&apos;;
    r_yw.Visible = &apos;on&apos;;
    %track_view.Visible = &apos;on&apos;;
    
elseif strcmp(surface_popup,&apos;Constant friction coefficient scaling factor&apos;)
    lambda_g.Visible = &apos;on&apos;;
    lambda_r.Visible = &apos;off&apos;;
    r_x0.Visible = &apos;off&apos;;
    r_y0.Visible = &apos;off&apos;;
    r_xw.Visible = &apos;off&apos;;
    r_yw.Visible = &apos;off&apos;;
    %track_view.Visible = &apos;off&apos;;
end
[~]=autosharedicon(&apos;autolibutils&apos;,gcb,0);</Callback>
        <TypeOptions>
          <Option>Constant friction coefficient scaling factor</Option>
          <Option>Split friction coefficient scaling factor</Option>
        </TypeOptions>
      </MaskParameter>
      <MaskParameter Name="lambda_g" Type="edit">
        <Prompt>Scaling factor for the friction coefficient of ground, lambda_g :</Prompt>
        <Value>EnvNomFrictionScaling</Value>
      </MaskParameter>
      <MaskParameter Name="lambda_r" Type="edit">
        <Prompt>Scaling factor for the friction coefficient of rectangular surface, lambda_r :</Prompt>
        <Value>.6</Value>
      </MaskParameter>
      <MaskParameter Name="r_x0" Type="edit">
        <Prompt>X coordinate of lower left corner of rectangular surface, r_x0 [m]:</Prompt>
        <Value>175</Value>
      </MaskParameter>
      <MaskParameter Name="r_y0" Type="edit">
        <Prompt>Y coordinate of lower left corner of rectangular surface, r_y0 [m]:</Prompt>
        <Value>-100</Value>
      </MaskParameter>
      <MaskParameter Name="r_xw" Type="edit">
        <Prompt>Rectangular surface width in X direction, r_xw [m]:</Prompt>
        <Value>1000</Value>
      </MaskParameter>
      <MaskParameter Name="r_yw" Type="edit">
        <Prompt>Rectangular surface width in Y direction, r_yw [m]:</Prompt>
        <Value>500</Value>
      </MaskParameter>
      <MaskParameter Name="aMode" Type="edit" Tunable="off" Visible="off">
        <Value>2</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>Track description  (mask)</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>Generates a default or user-specified track which creates a rectangular surface of specified friction coefficient. The location of rectangular surface is relative to the origin of Body Fixed Coordinate System.The input of the block is X and Y coordinates of the wheel from the vehicle feedback bus. The block output is friction coefficient for all the wheels.</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="TrackImgGroupVar">
        <DialogControl Type="Image" Name="RefImg">
          <FilePath>splitmutrack.png</FilePath>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="TrackGroupVar">
        <DialogControl Type="Popup" Name="surface_popup">
          <Prompt>Type of surface:</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
        <DialogControl Type="Group" Name="ParameterGroupVar">
          <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
          <DialogControl Type="Edit" Name="lambda_g">
            <Prompt>Scaling factor for the friction coefficient of ground, lambda_g :</Prompt>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="lambda_r">
            <Prompt>Scaling factor for the friction coefficient of rectangular surface, lambda_r :</Prompt>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="r_x0">
            <Prompt>X coordinate of lower left corner of rectangular surface, r_x0 [m]:</Prompt>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="r_y0">
            <Prompt>Y coordinate of lower left corner of rectangular surface, r_y0 [m]:</Prompt>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="r_xw">
            <Prompt>Rectangular surface width in X direction, r_xw [m]:</Prompt>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="r_yw">
            <Prompt>Rectangular surface width in Y direction, r_yw [m]:</Prompt>
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
          <DialogControl Type="Edit" Name="aMode">
            <ControlOptions PromptLocation="left"/>
          </DialogControl>
        </DialogControl>
      </DialogControl>
    </Mask>
    <System Ref="system_27863"/>
  </Block>
